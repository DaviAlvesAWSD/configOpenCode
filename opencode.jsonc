{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git commit*": "ask",
      "git push*": "ask",
      "git merge*": "ask"
    },
    "external_directory": {
      "~/jorge-pet/**": "allow"
    }
  },
  "compaction": { "auto": true, "tail_turns": 15 },
  "tool_output": { "max_lines": 200, "max_bytes": 8192 }
}